<Window x:Class="FlowType.UI.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to FlowType"
        Width="680" Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}">
    <DockPanel Margin="34,30,34,24">

        <!-- Footer: progress dots + nav buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="Step1Dot" Width="8" Height="8" Margin="3,0"/>
                <Ellipse x:Name="Step2Dot" Width="8" Height="8" Margin="3,0"/>
                <Ellipse x:Name="Step3Dot" Width="8" Height="8" Margin="3,0"/>
                <Ellipse x:Name="Step4Dot" Width="8" Height="8" Margin="3,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Style="{StaticResource GhostButton}" Content="Back"
                        Visibility="Hidden" Click="Back_Click" Margin="0,0,10,0"/>
                <Button x:Name="NextButton" Style="{StaticResource AccentButton}" Content="Next"
                        MinWidth="110" Click="Next_Click"/>
            </StackPanel>
        </DockPanel>

        <Grid>
            <!-- ===== Step 1: Welcome ===== -->
            <StackPanel x:Name="Step1" VerticalAlignment="Center">
                <Image Source="/Resources/logo.png" Width="84" Height="84"
                       HorizontalAlignment="Center"/>
                <TextBlock Text="Welcome to FlowType" FontSize="28" FontWeight="SemiBold"
                           FontFamily="{StaticResource DisplayFont}"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="Speak anywhere your cursor is. FlowType turns your voice into clean, formatted text — in any app."
                           Style="{StaticResource Hint}" FontSize="14" TextAlignment="Center"
                           MaxWidth="440" Margin="0,10,0,26" HorizontalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,4"
                               Text="🎙️   Hold a key, talk, release — your words appear"/>
                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,4"
                               Text="🔒   100% local AI — audio never leaves this PC"/>
                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,4"
                               Text="✨   Filler words removed, punctuation handled"/>
                    <TextBlock Foreground="{StaticResource TextBrush}" FontSize="13.5" Margin="0,4"
                               Text="🇬🇧   British or American spelling, your choice"/>
                </StackPanel>
            </StackPanel>

            <!-- ===== Step 2: Microphone ===== -->
            <StackPanel x:Name="Step2" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Pick your microphone" FontSize="24" FontWeight="SemiBold"
                           FontFamily="{StaticResource DisplayFont}"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Say something — the meter should move. If it doesn't, try another device."
                           Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,22"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="MicCombo" Width="360" SelectionChanged="Mic_Changed"/>
                    <Button Style="{StaticResource GhostButton}" Content="Refresh"
                            Margin="10,0,0,0" Click="RefreshMics_Click"/>
                </StackPanel>
                <ProgressBar x:Name="LevelBar" Height="10" Maximum="1" Margin="0,18,0,0"
                             Width="460" HorizontalAlignment="Left"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                           Text="Tip: Windows controls mic permissions under Settings → Privacy &amp; security → Microphone."/>
            </StackPanel>

            <!-- ===== Step 3: AI model ===== -->
            <StackPanel x:Name="Step3" Visibility="Collapsed">
                <TextBlock Text="Choose your AI model" FontSize="24" FontWeight="SemiBold"
                           FontFamily="{StaticResource DisplayFont}"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="This is the brain that turns speech into text, downloaded once and run locally. You can switch anytime in Settings."
                           Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,16"/>
                <TextBlock x:Name="ModelStatusText" Style="{StaticResource Hint}" FontSize="12.5"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ModelList"/>
                </ScrollViewer>
            </StackPanel>

            <!-- ===== Step 4: Hotkey & practice ===== -->
            <StackPanel x:Name="Step4" Visibility="Collapsed">
                <TextBlock Text="Your hotkey" FontSize="24" FontWeight="SemiBold"
                           FontFamily="{StaticResource DisplayFont}"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,16"
                           Text="Hold it and talk — release to insert. Quick-tap it to dictate hands-free. Esc cancels."/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Hotkey" Style="{StaticResource FieldLabel}" Width="70"/>
                    <ComboBox x:Name="HotkeyCombo" Width="230" SelectionChanged="Hotkey_Changed"/>
                    <Button x:Name="DetectKeyButton" Style="{StaticResource GhostButton}"
                            Content="Detect key…" Margin="10,0,0,0" Click="DetectKey_Click"/>
                </StackPanel>
                <TextBlock x:Name="DetectHint" Style="{StaticResource Hint}" Margin="70,8,0,0"
                           Text="Prefer a different key? Click “Detect key…” and press it — mouse side-buttons work too."/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="English" Style="{StaticResource FieldLabel}" Width="70"/>
                    <ComboBox x:Name="VariantCombo" Width="230" SelectionChanged="Variant_Changed"/>
                </StackPanel>

                <TextBlock x:Name="PracticeHint" Style="{StaticResource Hint}" FontSize="13"
                           Margin="0,18,0,8" Foreground="{StaticResource TextBrush}"/>
                <TextBox x:Name="PracticeBox" Height="104" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Text="Worked? Hit Finish. FlowType lives in your system tray and the little bar at the bottom of your screen. Esc cancels a recording; quick-tap the hotkey for hands-free."/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
