<Window x:Class="FlowType.UI.LearnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Learn from your writing — FlowType"
        Width="760" Height="720"
        MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="15"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- Painted, not transparent: the snapshot diagnostic crops to what is drawn,
         and an unpainted root would lose the header's top margin. -->
    <DockPanel Background="{StaticResource BgBrush}">

        <!-- ===== Header: the same eyebrow in every state, a title and one line that change ===== -->
        <StackPanel DockPanel.Dock="Top" Margin="34,28,34,0">
            <TextBlock Text="LEARN FROM YOUR WRITING" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="HeaderTitle" FontSize="24" FontWeight="SemiBold"
                       FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="HeaderText" Style="{StaticResource Hint}" FontSize="14" LineHeight="21"
                       Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- ===== Footer: the "don't suggest again" choice (Results only) and the buttons ===== -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0"
                Padding="34,16,34,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="DismissCheck" IsChecked="True" Margin="0,0,16,0" Visibility="Collapsed"
                          VerticalAlignment="Center"
                          ToolTip="Anything you leave unticked here won't be suggested again. Ones you never scrolled to, or left behind “Show more”, aren't affected.">
                    <TextBlock Text="Don't suggest the ones I left unticked" FontSize="13.5"
                               Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap"/>
                </CheckBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SecondaryButton" Style="{StaticResource GhostButton}" Content="Close"
                            MinWidth="88" Click="SecondaryButton_Click"/>
                    <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" Content="Start"
                            MinWidth="120" Margin="10,0,0,0" Click="PrimaryButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Body: one panel per state; exactly one is visible ===== -->
        <Grid Margin="0,18,0,0">

            <!-- Ready: what to learn from -->
            <ScrollViewer x:Name="ReadyPanel" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="34,0,34,20">
                    <Border x:Name="ReadyBanner" Style="{StaticResource InsetRow}" Visibility="Collapsed"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ReadyBannerText" Style="{StaticResource Hint}" FontSize="13.5"
                                       Foreground="{StaticResource SoftTextBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="ReadyBannerLink" Grid.Column="1" Style="{StaticResource LinkButton}"
                                    Content="Review them" FontSize="13.5" Margin="14,0,0,0"
                                    VerticalAlignment="Center" Click="ReadyBannerLink_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Learn from" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <StackPanel x:Name="SourceList"/>

                    <TextBlock Text="Check the result" Style="{StaticResource SectionTitle}" Margin="0,14,0,12"/>
                    <Border Style="{StaticResource InsetRow}">
                        <StackPanel>
                            <CheckBox x:Name="BenchCheck" HorizontalAlignment="Stretch">
                                <TextBlock x:Name="BenchLabel" FontSize="15" Foreground="{StaticResource TextBrush}"
                                           TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock x:Name="BenchHint" Style="{StaticResource Hint}" Margin="28,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="2,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLock}"
                              Stroke="{StaticResource FaintBrush}" VerticalAlignment="Top" Margin="0,0,10,0">
                            <Path.LayoutTransform>
                                <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                            </Path.LayoutTransform>
                        </Path>
                        <TextBlock Grid.Column="1" Style="{StaticResource Hint}" FontSize="12.5" LineHeight="18"
                                   Foreground="{StaticResource FaintBrush}"
                                   Text="Everything happens on this PC. Your past dictations are read into memory for this check and not saved anywhere else. Nothing changes until you approve it on the next screen."/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Running: stage, progress, elapsed -->
            <Grid x:Name="RunningPanel" Visibility="Collapsed" Margin="34,0,34,20">
                <StackPanel VerticalAlignment="Center" MaxWidth="520" Margin="0,0,0,40">
                    <TextBlock x:Name="StageText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                    <Border x:Name="ProgressTrack" Height="8" CornerRadius="4" Margin="0,14,0,0"
                            Background="{StaticResource StrokeBrush}" ClipToBounds="True"
                            SizeChanged="ProgressTrack_SizeChanged">
                        <Border x:Name="ProgressFill" CornerRadius="4" Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="Left" Width="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ProgressSlide"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DetailText" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="ElapsedText" Grid.Column="1" Style="{StaticResource Hint}"
                                   Foreground="{StaticResource FaintBrush}" Margin="16,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Results: one card per kind of suggestion -->
            <!-- ScrollChanged decides which rows count as seen (and so can be dismissed). -->
            <ScrollViewer x:Name="ResultsPanel" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="Collapsed" ScrollChanged="ResultsPanel_ScrollChanged">
                <StackPanel x:Name="ResultsList" Margin="34,0,34,20"/>
            </ScrollViewer>

            <!-- Applied: what changed and where to find it -->
            <ScrollViewer x:Name="AppliedPanel" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="Collapsed">
                <StackPanel Margin="34,0,34,20">
                    <Border Style="{StaticResource Card}" Padding="28,26">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top"
                                    Background="{StaticResource AccentSoftBrush}" Margin="0,0,18,0">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCheck}"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="AppliedText" Style="{StaticResource BodyText}" FontSize="16"
                                           LineHeight="24"/>
                                <TextBlock x:Name="AppliedWhere" Style="{StaticResource Hint}" FontSize="14"
                                           LineHeight="21" Margin="0,6,0,0"/>
                                <WrapPanel x:Name="AppliedLinks" Margin="0,14,0,0">
                                    <Button x:Name="OpenDictionaryLink" Style="{StaticResource LinkButton}"
                                            Content="Open Dictionary" Margin="0,0,22,0" Click="OpenDictionary_Click"/>
                                    <Button x:Name="OpenSnippetsLink" Style="{StaticResource LinkButton}"
                                            Content="Open Snippets" Margin="0,0,22,0" Click="OpenSnippets_Click"/>
                                    <Button x:Name="OpenStyleLink" Style="{StaticResource LinkButton}"
                                            Content="Open Style" Click="OpenStyle_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="AppliedUndoHint" Style="{StaticResource Hint}" FontSize="13"
                               Foreground="{StaticResource FaintBrush}" Margin="2,0,0,0"
                               Text="Changed your mind? Insights → Learn from your writing → “Undo everything learned” removes every word, fix and snippet added this way. Entries you added yourself are kept."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
