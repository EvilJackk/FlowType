<UserControl x:Class="FlowType.UI.Pages.StylePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="Body" Style="{StaticResource PageBody}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Style" Margin="0"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="How your words read, chosen per kind of app — a text to a friend shouldn't read like an email to a client. Pick one style for each."/>

            <Border Style="{StaticResource SegmentBar}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabPersonal" Style="{StaticResource SegmentTab}" GroupName="StyleTabs"
                                 Content="Personal messages" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabWork" Style="{StaticResource SegmentTab}" GroupName="StyleTabs"
                                 Content="Work messages" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabEmail" Style="{StaticResource SegmentTab}" GroupName="StyleTabs"
                                 Content="Email" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabOther" Style="{StaticResource SegmentTab}" GroupName="StyleTabs"
                                 Content="Everything else" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="BucketHint" Style="{StaticResource Hint}" FontSize="14" Margin="2,16,0,16"/>

            <Grid x:Name="StyleCards" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            </Grid>

            <!-- How it's applied -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="How a style is applied"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconStyle}"
                              Stroke="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Rules, on every dictation" FontSize="15" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                       Text="Capitals, the final full stop and the exclamation mark are set by fixed rules on this PC — instant, offline, no AI needed. Lists, multi-line text and anything that looks like code are left exactly as dictated."/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconAi}"
                              Stroke="{StaticResource MutedBrush}" VerticalAlignment="Top" Margin="0,0,14,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="AI polish, when it's on" FontSize="15" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                       Text="The on-device model is told which style to write in, so word choice and tone follow it too — not just punctuation."/>
                            <TextBlock x:Name="AiStatusText" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Foreground="{StaticResource SoftTextBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="AI settings"
                                VerticalAlignment="Top" Margin="16,0,0,0" Click="AiSettings_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
