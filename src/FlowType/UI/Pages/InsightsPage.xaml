<UserControl x:Class="FlowType.UI.Pages.InsightsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="Body" Style="{StaticResource PageBody}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Insights" Margin="0"/>
            <TextBlock x:Name="InsightsSubtitle" Style="{StaticResource PageSubtitle}"/>

            <!-- Learn from your writing (2.1): look back over past dictations and suggest
                 words, fixes and styles. Filled in code; see RenderLearnCard. -->
            <Border x:Name="LearnCard" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="LEARN FROM YOUR WRITING" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Style="{StaticResource BodyText}" FontSize="14.5" LineHeight="21"
                                       Foreground="{StaticResource SoftTextBrush}" Margin="0,10,0,0"
                                       Text="FlowType can look back over what you've already dictated and suggest words to listen for, fixes for what it mishears, and the style you really write in. Nothing changes until you approve it."/>
                            <TextBlock x:Name="LearnSources" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                            <TextBlock x:Name="LearnLastRun" Style="{StaticResource Hint}" FontSize="12.5"
                                       Foreground="{StaticResource FaintBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="LearnButton" Grid.Column="1" Style="{StaticResource AccentButton}"
                                Content="Learn from my history" VerticalAlignment="Center"
                                Click="LearnButton_Click"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,18,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center">
                            <CheckBox x:Name="LearnDailySwitch" Style="{StaticResource Switch}" Margin="0,4,28,4"
                                      Checked="LearnDailySwitch_Changed" Unchecked="LearnDailySwitch_Changed"
                                      AutomationProperties.Name="Check for new suggestions once a day"
                                      ToolTip="Once a day, while you're not dictating, FlowType looks over new dictations and lines up suggestions for you to review. It reads Wispr Flow's history only if you've ticked it in the review window.">
                                <TextBlock Text="Check for new suggestions once a day" FontSize="13.5"
                                           Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="LearnAutoSwitch" Style="{StaticResource Switch}" Margin="0,4,28,4"
                                      Checked="LearnAutoSwitch_Changed" Unchecked="LearnAutoSwitch_Changed"
                                      AutomationProperties.Name="Add new words automatically"
                                      ToolTip="Words the daily check is confident about go straight into Dictionary — never fixes or styles. “Undo everything learned” removes them too.">
                                <TextBlock Text="Add new words automatically" FontSize="13.5"
                                           Foreground="{StaticResource SoftTextBrush}" TextWrapping="Wrap"/>
                            </CheckBox>
                        </WrapPanel>
                        <Button x:Name="LearnUndo" Grid.Column="1" Style="{StaticResource ChipButton}"
                                VerticalAlignment="Center" Margin="12,0,-8,0" Visibility="Collapsed"
                                Click="LearnUndo_Click"
                                ToolTip="Remove every word, fix and snippet added from your history. Entries you added yourself stay."/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Three headline numbers -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SPEAKING PACE" Style="{StaticResource Eyebrow}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="InsightWpm" Text="—" Style="{StaticResource StatValue}" FontSize="38"/>
                            <TextBlock Text="wpm" Style="{StaticResource Hint}" FontSize="14"
                                       VerticalAlignment="Bottom" Margin="8,0,0,7"/>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,14,0,12"/>
                        <TextBlock x:Name="InsightWpmCompare" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="InsightWpmBest" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="FIXES MADE FOR YOU" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="InsightFixes" Text="—" Style="{StaticResource StatValue}"
                                   FontSize="38" Margin="0,10,0,0"/>
                        <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,14,0,12"/>
                        <TextBlock x:Name="InsightCorrected" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="InsightDictFixes" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="InsightFormatFixes" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="WORDS DICTATED" Style="{StaticResource Eyebrow}"/>
                        <TextBlock x:Name="InsightWords" Text="—" Style="{StaticResource StatValue}"
                                   FontSize="38" Margin="0,10,0,0"/>
                        <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,14,0,12"/>
                        <TextBlock x:Name="InsightTakes" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="InsightSpeaking" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Activity heatmap -->
            <Border Style="{StaticResource Card}" x:Name="HeatmapCard">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="InsightStreak" Style="{StaticResource SectionTitle}" Text="Activity"/>
                            <TextBlock x:Name="InsightLongest" Style="{StaticResource Hint}" Margin="12,1,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" x:Name="HeatLegend" Orientation="Horizontal"
                                    VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel x:Name="InsightHeatmap" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- Where and in which apps -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="InsightAppCount" DockPanel.Dock="Right"
                                       Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Where you dictate"/>
                        </DockPanel>
                        <StackPanel x:Name="InsightCategories" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Top apps" Margin="0,0,0,4"/>
                        <StackPanel x:Name="InsightTopApps" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
