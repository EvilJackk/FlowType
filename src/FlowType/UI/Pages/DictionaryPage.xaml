<UserControl x:Class="FlowType.UI.Pages.DictionaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="Body" Style="{StaticResource PageBody}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Dictionary" Margin="0"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Teach FlowType your words. A word on its own — a name, a product, some jargon — is listened for, so it comes out spelled right. Add what it should become to fix something it keeps mishearing."/>

            <!-- Add -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Add a word" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PhraseBox" Grid.Column="0" Tag="Word or phrase — e.g. Kubernetes"
                                 KeyDown="AddBox_KeyDown" AutomationProperties.Name="Word or phrase"/>
                        <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="{StaticResource FaintBrush}"
                                   VerticalAlignment="Center" Margin="14,0"/>
                        <TextBox x:Name="ReplacementBox" Grid.Column="2"
                                 Tag="Becomes (optional) — e.g. a fix for a mishearing"
                                 KeyDown="AddBox_KeyDown" AutomationProperties.Name="Replacement (optional)"/>
                        <Button Grid.Column="3" Style="{StaticResource AccentButton}"
                                Content="Add" Margin="12,0,0,0" MinWidth="76" Click="AddDictEntry_Click"/>
                    </Grid>
                    <CheckBox x:Name="WholeWordCheck" IsChecked="True" Margin="0,14,0,0"
                              Content="Match whole words only (recommended)"/>
                    <TextBlock x:Name="AddErrorText" Style="{StaticResource Hint}" Foreground="{StaticResource DangerBrush}"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Filter + search -->
            <Grid Margin="0,10,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SegmentBar}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterAll" Style="{StaticResource SegmentTab}" GroupName="DictFilter"
                                     IsChecked="True" Checked="Filter_Checked"/>
                        <RadioButton x:Name="FilterWords" Style="{StaticResource SegmentTab}" GroupName="DictFilter"
                                     Checked="Filter_Checked"/>
                        <RadioButton x:Name="FilterRules" Style="{StaticResource SegmentTab}" GroupName="DictFilter"
                                     Checked="Filter_Checked"/>
                        <RadioButton x:Name="FilterLearned" Style="{StaticResource SegmentTab}" GroupName="DictFilter"
                                     Checked="Filter_Checked"/>
                    </StackPanel>
                </Border>
                <TextBox x:Name="DictSearchBox" Grid.Column="1" Style="{StaticResource SearchBox}" Width="230" Margin="12,0,0,0"
                         Tag="Search dictionary" TextChanged="DictSearch_TextChanged"
                         AutomationProperties.Name="Search dictionary"/>
            </Grid>

            <Border x:Name="DictEmpty" Style="{StaticResource Card}" Padding="28,30" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="DictEmptyTitle" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" Text="No words yet"/>
                    <TextBlock x:Name="DictEmptyText" Style="{StaticResource Hint}" Margin="0,6,0,0"
                               TextAlignment="Center" MaxWidth="480"/>
                </StackPanel>
            </Border>

            <Border x:Name="DictCard" Style="{StaticResource Card}" Padding="6">
                <StackPanel x:Name="DictList"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
