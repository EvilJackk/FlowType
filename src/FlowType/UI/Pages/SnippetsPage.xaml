<UserControl x:Class="FlowType.UI.Pages.SnippetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="Body" Style="{StaticResource PageBody}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Snippets" Margin="0"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Say a short trigger, get a whole block of text — an address, a booking link, a sign-off. Say the trigger on its own and the expansion replaces the whole dictation; say it mid-sentence and it is swapped in place."/>

            <!-- Add -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="New snippet" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="When I say" Style="{StaticResource FieldLabel}" Width="Auto"/>
                        <TextBox x:Name="TriggerBox" Grid.Column="1" Tag="e.g. my calendar link"
                                 AutomationProperties.Name="Trigger phrase"/>
                        <TextBlock Grid.Row="1" Text="Insert" Style="{StaticResource FieldLabel}" Width="Auto"
                                   VerticalAlignment="Top" Margin="0,22,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                            <TextBox x:Name="ExpansionBox" Height="118" AcceptsReturn="True" AcceptsTab="False"
                                     TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="4000"
                                     VerticalScrollBarVisibility="Auto"
                                     Tag="The text to insert — line breaks are kept"
                                     AutomationProperties.Name="Expansion text"/>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Add snippet"
                                        Click="AddSnippet_Click"/>
                                <TextBlock x:Name="ExpansionCounter" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource FaintBrush}"/>
                                <TextBlock x:Name="AddErrorText" Style="{StaticResource Hint}" Margin="14,0,12,0"
                                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,10,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SectionHeading}" Text="Your snippets"/>
                    <TextBlock x:Name="SnippetCountText" Style="{StaticResource Hint}" Margin="12,4,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox x:Name="SnippetSearchBox" Grid.Column="1" Style="{StaticResource SearchBox}" Width="230"
                         Tag="Search snippets" TextChanged="SnippetSearch_TextChanged"
                         AutomationProperties.Name="Search snippets"/>
            </Grid>

            <Border x:Name="SnippetsEmpty" Style="{StaticResource Card}" Padding="28,30" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="SnippetsEmptyTitle" Style="{StaticResource SectionTitle}"
                               HorizontalAlignment="Center" Text="No snippets yet"/>
                    <TextBlock x:Name="SnippetsEmptyText" Style="{StaticResource Hint}" Margin="0,6,0,0"
                               TextAlignment="Center" MaxWidth="480"
                               Text="Good first ones: your email address, a scheduling link, your home address, a signature."/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="SnippetList"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
