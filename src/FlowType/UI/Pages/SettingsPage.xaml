<UserControl x:Class="FlowType.UI.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FlowType.UI.Controls">
    <UserControl.Resources>
        <!-- Cards on this page hold rows that bring their own vertical padding. -->
        <Style x:Key="RowsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="24,2,24,2"/>
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionHeading}">
            <Setter Property="Margin" Value="2,26,0,12"/>
            <Setter Property="FontSize" Value="19"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="Body" Style="{StaticResource PageBody}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" Margin="0,0,0,14"/>

            <!-- Jump bar -->
            <WrapPanel x:Name="JumpBar" Margin="-8,0,0,0">
                <Button Style="{StaticResource ChipButton}" Content="Dictation" Tag="dictation" Click="Jump_Click"/>
                <Button Style="{StaticResource ChipButton}" Content="Microphone" Tag="microphone" Click="Jump_Click"/>
                <Button Style="{StaticResource ChipButton}" Content="Speech model" Tag="model" Click="Jump_Click"/>
                <Button Style="{StaticResource ChipButton}" Content="Output" Tag="output" Click="Jump_Click"/>
                <Button Style="{StaticResource ChipButton}" Content="Formatting" Tag="formatting" Click="Jump_Click"/>
                <Button Style="{StaticResource ChipButton}" Content="Context" Tag="context" Click="Jump_Click"/>
                <Button Style="{StaticResource ChipButton}" Content="Privacy" Tag="privacy" Click="Jump_Click"/>
                <Button Style="{StaticResource ChipButton}" Content="System" Tag="system" Click="Jump_Click"/>
                <Button Style="{StaticResource ChipButton}" Content="About" Tag="about" Click="Jump_Click"/>
            </WrapPanel>

            <!-- ============ DICTATION ============ -->
            <TextBlock x:Name="SecDictation" Style="{StaticResource SettingsHeading}" Text="Dictation" Margin="2,18,0,12"/>
            <Border Style="{StaticResource RowsCard}">
                <StackPanel>
                    <controls:SettingRow BorderThickness="0" Title="Hotkey"
                                         Description="Hold it anywhere and talk. Keyboard keys, chords and mouse buttons all work.">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="HotkeyCombo" Width="210" SelectionChanged="Setting_Changed"
                                      AutomationProperties.Name="Hotkey"/>
                            <Button x:Name="DetectKeyButton" Style="{StaticResource GhostButton}"
                                    Content="Detect key…" Margin="8,0,0,0" Click="DetectKey_Click"/>
                        </StackPanel>
                    </controls:SettingRow>

                    <!-- Live key monitor: "the key does nothing" is diagnosable on sight. -->
                    <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LIVE" Style="{StaticResource Eyebrow}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Ellipse x:Name="HotkeyStateDot" Width="9" Height="9"
                                         Fill="#3A3936" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HotkeyStateText" Text="hotkey not pressed" FontSize="13.5"
                                           Foreground="{StaticResource SoftTextBrush}" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="·" Foreground="{StaticResource FaintBrush}" Margin="12,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="LastKeyText" Style="{StaticResource Hint}"
                                           VerticalAlignment="Center" Text="last key seen: —"/>
                            </StackPanel>
                            <TextBlock x:Name="CaptureStatusText" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Key not responding? Click “Detect key…”, then press the key (or mouse button) you want — FlowType binds to whatever your keyboard actually sends."/>
                        </StackPanel>
                    </Border>

                    <controls:SettingRow Title="How the hotkey works">
                        <controls:SettingRow.Extra>
                            <StackPanel>
                                <RadioButton x:Name="ModeSmartRadio" GroupName="Activation"
                                             Content="Smart — hold to talk, quick-tap for hands-free (recommended)"
                                             Checked="Setting_Changed"/>
                                <RadioButton x:Name="ModeHoldRadio" GroupName="Activation" Margin="0,10,0,0"
                                             Content="Hold only (push-to-talk)"
                                             Checked="Setting_Changed"/>
                                <RadioButton x:Name="ModeToggleRadio" GroupName="Activation" Margin="0,10,0,0"
                                             Content="Toggle only (press to start, press to stop)"
                                             Checked="Setting_Changed"/>
                            </StackPanel>
                        </controls:SettingRow.Extra>
                    </controls:SettingRow>

                    <controls:SettingRow Title="Language"
                                         Description="Auto-detect works across languages; picking one is faster and steadier on short takes.">
                        <ComboBox x:Name="LanguageCombo" Width="280" SelectionChanged="Setting_Changed"
                                  AutomationProperties.Name="Language"/>
                    </controls:SettingRow>

                    <controls:SettingRow Title="English spelling"
                                         Description="British (colour, realise, centre) or American (color, realize, center). Also nudges recognition toward that vocabulary.">
                        <ComboBox x:Name="EnglishVariantCombo" Width="280" SelectionChanged="Setting_Changed"
                                  AutomationProperties.Name="English spelling"/>
                    </controls:SettingRow>

                    <controls:SettingRow Title="Cancelling"
                                         Description="Esc always cancels a recording. In hold mode, pressing another key while holding cancels too — so Ctrl+C and friends still work normally."/>
                </StackPanel>
            </Border>

            <!-- ============ MICROPHONE ============ -->
            <TextBlock x:Name="SecMicrophone" Style="{StaticResource SettingsHeading}" Text="Microphone"/>
            <Border Style="{StaticResource RowsCard}">
                <StackPanel>
                    <controls:SettingRow BorderThickness="0" Title="Input device"
                                         Description="Click Test and speak — the bar should move.">
                        <controls:SettingRow.Extra>
                            <ProgressBar x:Name="MicLevelBar" Height="6" Maximum="1" MaxWidth="320"
                                         HorizontalAlignment="Left" Width="320"/>
                        </controls:SettingRow.Extra>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="MicCombo" Width="250" SelectionChanged="Setting_Changed"
                                      AutomationProperties.Name="Microphone"/>
                            <Button Style="{StaticResource GhostButton}" Content="Refresh"
                                    Margin="8,0,0,0" Click="RefreshMics_Click"/>
                            <Button x:Name="MicTestButton" Style="{StaticResource GhostButton}"
                                    Content="Test" MinWidth="64" Margin="8,0,0,0" Click="MicTest_Click"/>
                        </StackPanel>
                    </controls:SettingRow>

                    <controls:SettingRow Title="Sounds" Description="A soft chime when recording starts and stops.">
                        <CheckBox x:Name="SoundsCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Sounds"/>
                    </controls:SettingRow>

                    <controls:SettingRow Title="Quiet other apps while dictating"
                                         Description="Music and videos are muted while the mic is open and come back the moment you stop.">
                        <CheckBox x:Name="MuteMediaCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Quiet other apps while dictating"/>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ============ SPEECH MODEL ============ -->
            <TextBlock x:Name="SecModel" Style="{StaticResource SettingsHeading}" Text="Speech model"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                Content="Open models folder" Click="OpenModelsFolder_Click"/>
                        <TextBlock x:Name="ModelsStatusText" FontSize="14" Foreground="{StaticResource SoftTextBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DockPanel>
                    <StackPanel x:Name="ModelsList"/>

                    <controls:SettingRow Margin="0,10,0,0" Title="Use the graphics card (Vulkan)"
                                         Description="Much faster on a GPU, and falls back to the processor by itself. Restart FlowType to apply.">
                        <CheckBox x:Name="GpuCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Use the graphics card"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Accurate decoding"
                                         Description="Keeps five candidate readings alive instead of committing to the first guess (beam search) — hears unclear, quiet and mumbled speech better. Free on a GPU; roughly 1.5–2× slower on CPU.">
                        <CheckBox x:Name="AccurateCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Accurate decoding"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Transcribe while you talk" Padding="0,16,0,2"
                                         Description="On long dictations (past about 20 seconds) the speech is transcribed at natural pauses while you are still talking, so the text is ready almost as soon as you stop.">
                        <CheckBox x:Name="LiveTranscriptionCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Transcribe while you talk"/>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ============ OUTPUT ============ -->
            <TextBlock x:Name="SecOutput" Style="{StaticResource SettingsHeading}" Text="Output"/>
            <Border Style="{StaticResource RowsCard}">
                <StackPanel>
                    <controls:SettingRow BorderThickness="0" Title="Put the text into the app you're in"
                                         Description="Off copies it to the clipboard instead.">
                        <controls:SettingRow.Extra>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PasteRadio" GroupName="InsertMethod" Content="Paste (fast, default)"
                                             Checked="Setting_Changed"/>
                                <RadioButton x:Name="TypeRadio" GroupName="InsertMethod"
                                             Content="Type it out (for apps that block pasting)"
                                             Margin="22,0,0,0" Checked="Setting_Changed"/>
                            </StackPanel>
                        </controls:SettingRow.Extra>
                        <CheckBox x:Name="AutoInsertCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Put the text into the app"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Add a space after a finished sentence"
                                         Description="So two dictations in a row don't run together. Skipped after links, addresses and code.">
                        <CheckBox x:Name="TrailingSpaceCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Add a space after a finished sentence"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Restore the clipboard after pasting"
                                         Description="Whatever you had copied is put back once the dictation is in.">
                        <CheckBox x:Name="RestoreClipboardCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Restore the clipboard after pasting"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="“Press enter” to send"
                                         Description="End a dictation with “press enter” and FlowType presses it for you — for chats, terminals and search boxes.">
                        <CheckBox x:Name="PressEnterCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Press enter to send"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Paste-last shortcuts"
                                         Description="Missed the text box? Put your last dictation in again, or copy it.">
                        <controls:SettingRow.Extra>
                            <WrapPanel x:Name="PasteLastKeys"/>
                        </controls:SettingRow.Extra>
                        <CheckBox x:Name="PasteLastCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Paste-last shortcuts"/>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ============ FORMATTING ============ -->
            <TextBlock x:Name="SecFormatting" Style="{StaticResource SettingsHeading}" Text="Formatting"/>
            <Border Style="{StaticResource RowsCard}">
                <StackPanel>
                    <controls:SettingRow BorderThickness="0" Title="Remove filler words"
                                         Description="um, uh, erm, hmm…">
                        <CheckBox x:Name="FillersCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Remove filler words"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="“Scratch that”"
                                         Description="Keep only what you say after a correction.">
                        <CheckBox x:Name="ScratchCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Scratch that"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="“New line” and “new paragraph”"
                                         Description="Spoken commands that insert line breaks.">
                        <CheckBox x:Name="LineCmdCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="New line commands"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Spoken punctuation"
                                         Description="Say “period”, “comma”, “question mark”… to type them.">
                        <CheckBox x:Name="PunctCmdCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Spoken punctuation"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="No full stop after emails, links and numbers"
                                         Description="So a dictated address can be pasted straight into a field.">
                        <CheckBox x:Name="SmartPunctCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="No full stop after emails, links and numbers"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Fix near-misses of your dictionary words"
                                         Description="Matches by sound as well as spelling, so one entry covers every way a name gets misheard.">
                        <CheckBox x:Name="FuzzyVocabCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Fix near-misses of dictionary words"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Learn from corrections you type"
                                         Description="Backspace over a word FlowType got wrong and type the right one — it becomes a dictionary entry and the bar says so. Watched only for a few seconds after FlowType inserts text; keystrokes are never recorded.">
                        <CheckBox x:Name="LearnCorrectionsCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Learn from corrections"/>
                    </controls:SettingRow>

                    <TextBlock Text="AUTOMATIC FORMATTING" Style="{StaticResource Eyebrow}" Margin="0,22,0,2"/>
                    <controls:SettingRow BorderThickness="0" Title="Start a new paragraph where you paused"
                                         Description="Measured from the pause in your speech, not guessed from the words. Only on longer dictations.">
                        <CheckBox x:Name="AutoParagraphsCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Paragraphs at pauses"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Numbered lists"
                                         Description="“First… second… third…” becomes a numbered list.">
                        <CheckBox x:Name="AutoListsCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Numbered lists"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Addresses, links, money, times and quotes"
                                         Description="“roy at example dot com” → roy@example.com · “25 percent” → 25% · “3 30 p.m.” → 3:30 PM · “quote … unquote” → “…”">
                        <CheckBox x:Name="SmartSymbolsCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Addresses, links, money, times and quotes"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Capitalise API, GitHub, iPhone and the like"
                                         Description="Product names and acronyms come out the way they're written.">
                        <CheckBox x:Name="KnownTermsCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Capitalise known terms"/>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ============ CONTEXT ============ -->
            <TextBlock x:Name="SecContext" Style="{StaticResource SettingsHeading}" Text="Context"/>
            <Border Style="{StaticResource RowsCard}">
                <StackPanel>
                    <controls:SettingRow BorderThickness="0" Title="Fit the text you're dictating into"
                                         Description="FlowType reads the text field your cursor is in so new words fit what's already there: no capital in the middle of a sentence, the right spacing, and names spelled the way they already appear.">
                        <controls:SettingRow.Extra>
                            <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource StrokeBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLock}"
                                          Stroke="{StaticResource AccentBrush}" VerticalAlignment="Top"
                                          Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Hint}"
                                               Foreground="{StaticResource SoftTextBrush}"
                                               Text="Read on this PC through Windows UI Automation, only at the moment you dictate. Password fields are never read. Nothing is stored, logged or sent anywhere — no screenshots, ever."/>
                                </Grid>
                            </Border>
                        </controls:SettingRow.Extra>
                        <CheckBox x:Name="ScreenContextCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Fit the text you're dictating into"/>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ============ PRIVACY ============ -->
            <TextBlock x:Name="SecPrivacy" Style="{StaticResource SettingsHeading}" Text="Privacy"/>
            <Border Style="{StaticResource RowsCard}">
                <StackPanel>
                    <controls:SettingRow BorderThickness="0" Title="Save transcripts to History"
                                         Description="Off means nothing you dictate is ever written to disk — stats still count words.">
                        <CheckBox x:Name="SaveHistoryCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Save transcripts to History"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Keep recent recordings"
                                         Description="So a dictation can be played back or transcribed again from History. Kept only on this PC; the oldest go first. Don't keep audio deletes each recording right after it's transcribed.">
                        <controls:SettingRow.Extra>
                            <WrapPanel>
                                <TextBlock x:Name="ArchiveUsageText" Style="{StaticResource Hint}"
                                           Foreground="{StaticResource SoftTextBrush}" Margin="0,2,16,0"/>
                                <Button x:Name="DeleteAudioButton" Style="{StaticResource LinkButton}" FontSize="13"
                                        Content="Delete them now" Margin="0,0,16,0"
                                        Click="DeleteAudio_Click"/>
                                <Button Style="{StaticResource LinkButton}" FontSize="13"
                                        Content="Open folder" Click="OpenAudioFolder_Click"/>
                            </WrapPanel>
                        </controls:SettingRow.Extra>
                        <ComboBox x:Name="KeepRecordingsCombo" Width="190" SelectionChanged="Setting_Changed"
                                  AutomationProperties.Name="Keep recent recordings"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Diagnostic log"
                                         Description="One line per dictation with timings and audio measurements — never any of your words. Useful when something goes wrong; safe to send to anyone.">
                        <CheckBox x:Name="DiagnosticLogCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Diagnostic log"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Pause dictation"
                                         Description="The hotkey is ignored until you switch this off — for games, screen shares and presentations.">
                        <CheckBox x:Name="PauseCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Pause dictation"/>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ============ SYSTEM ============ -->
            <TextBlock x:Name="SecSystem" Style="{StaticResource SettingsHeading}" Text="System"/>
            <Border Style="{StaticResource RowsCard}">
                <StackPanel>
                    <controls:SettingRow BorderThickness="0" Title="Start with Windows"
                                         Description="Launch FlowType when you sign in.">
                        <CheckBox x:Name="StartupCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Start with Windows"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Show the flow bar when idle"
                                         Description="Off hides it until you start dictating.">
                        <CheckBox x:Name="ShowBarCheck" Style="{StaticResource Switch}"
                                  Checked="Setting_Changed" Unchecked="Setting_Changed"
                                  AutomationProperties.Name="Show the flow bar when idle"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Flow bar position">
                        <ComboBox x:Name="BarPositionCombo" Width="230" SelectionChanged="Setting_Changed"
                                  AutomationProperties.Name="Flow bar position"/>
                    </controls:SettingRow>
                    <controls:SettingRow Title="Longest recording"
                                         Description="Safety cap for hands-free sessions, so a forgotten mic stops itself.">
                        <ComboBox x:Name="MaxLengthCombo" Width="230" SelectionChanged="Setting_Changed"
                                  AutomationProperties.Name="Longest recording"/>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- ============ ABOUT ============ -->
            <TextBlock x:Name="SecAbout" Style="{StaticResource SettingsHeading}" Text="About"/>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Resources/logo.png" Width="44" Height="44" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="AboutText" FontSize="15" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="CreditText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Open data folder"
                            VerticalAlignment="Top" Margin="16,0,0,0" Click="OpenDataFolder_Click"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
