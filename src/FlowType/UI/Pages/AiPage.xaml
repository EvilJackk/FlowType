<UserControl x:Class="FlowType.UI.Pages.AiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FlowType.UI.Controls">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="Body" Style="{StaticResource PageBody}">
            <TextBlock Style="{StaticResource PageTitle}" Text="On-device AI" Margin="0"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="An optional small language model that runs on this PC. It tidies dictations that need more than rules — self-corrections, spoken lists, long rambles — and carries out spoken instructions in Command Mode."/>

            <!-- Where the work happens -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="24,22,24,22">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLock}"
                                      Stroke="{StaticResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="FlowType — on this PC" Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="LocalList" Margin="0,14,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="24,22,24,22">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource HoverBrush}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCloud}"
                                          Stroke="{StaticResource MutedBrush}"/>
                                </Border>
                                <TextBlock Text="Cloud dictation apps" Style="{StaticResource SectionTitle}"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="CloudList" Margin="0,14,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0"
                                       Foreground="{StaticResource FaintBrush}"
                                       Text="Wispr Flow, for example, transcribes and formats every dictation on its servers."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Live status -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="LlmStatusDot" Width="9" Height="9" Margin="2,6,14,0"
                             VerticalAlignment="Top" Fill="{StaticResource FaintBrush}"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="LlmStatusText" FontSize="15" Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="LlmStatusDetail" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Models -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                                Content="Open folder" Click="OpenLlmFolder_Click" Margin="16,0,0,0"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Language model"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="Downloaded once from the publisher's own Hugging Face page and checked against a pinned SHA-256 before it is ever loaded."/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel x:Name="LlmList" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- Polish mode -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="AI polish"/>
                    <TextBlock x:Name="PolishHint" Style="{StaticResource Hint}" Margin="0,4,0,14"
                               Text="When the model rewrites a dictation. The rules — fillers, punctuation, your dictionary, your style — always run first."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="PolishOffRadio" Style="{StaticResource ChoiceCard}" GroupName="Polish"
                                     Checked="Polish_Checked">
                            <StackPanel>
                                <TextBlock Text="Off" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Rules only. Instant and completely predictable."/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PolishSmartRadio" Grid.Column="2" Style="{StaticResource ChoiceCard}"
                                     GroupName="Polish" Checked="Polish_Checked">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Smart" FontSize="16" FontWeight="Bold"/>
                                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6"
                                            Padding="7,1,7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Recommended" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Steps in only when a dictation needs it: “no wait”, stutters, lists, long takes."/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PolishAlwaysRadio" Grid.Column="4" Style="{StaticResource ChoiceCard}"
                                     GroupName="Polish" Checked="Polish_Checked">
                            <StackPanel>
                                <TextBlock Text="Always" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           Text="Every dictation goes through the model. Cleanest text, adds a moment."/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                    <controls:SettingRow BorderThickness="0" Margin="0,10,0,0" Title="Polish long dictations"
                                         Description="On: a long dictation is polished in parts, so there is no length limit. Off: one pass only, as before — around 1,000 words or more it runs out of time and the text goes in unpolished.">
                        <CheckBox x:Name="PolishLongCheck" Style="{StaticResource Switch}"
                                  Checked="PolishLong_Changed" Unchecked="PolishLong_Changed"
                                  AutomationProperties.Name="Polish long dictations"/>
                    </controls:SettingRow>
                </StackPanel>
            </Border>

            <!-- Command Mode -->
            <Border Style="{StaticResource Card}" Padding="24,8,24,22">
                <StackPanel>
                    <controls:SettingRow BorderThickness="0" Title="Command Mode"
                                         Description="Speak an instruction instead of text.">
                        <CheckBox x:Name="CommandModeCheck" Style="{StaticResource Switch}"
                                  Checked="CommandMode_Changed" Unchecked="CommandMode_Changed"
                                  AutomationProperties.Name="Command Mode"/>
                    </controls:SettingRow>
                    <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="18,16">
                        <StackPanel>
                            <WrapPanel x:Name="CommandKeys" Orientation="Horizontal"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="14" LineHeight="21" Margin="0,12,0,0"
                                       Text="Hold your dictation hotkey, press Alt, and speak an instruction. With text selected it rewrites the selection; otherwise it writes at the cursor."/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Foreground="{StaticResource FaintBrush}"
                                       Text="Try: “make this more formal” · “turn this into bullet points” · “write a short reply saying I'll be ten minutes late”"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="NoModelNote" Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Foreground="{StaticResource AccentBrush}" Visibility="Collapsed"
                               Text="Polish and Command Mode do nothing until a model is installed above."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
