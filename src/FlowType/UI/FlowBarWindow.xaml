<Window x:Class="FlowType.UI.FlowBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowType Bar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="520" Height="110">
    <Grid>
        <Border x:Name="Bar"
                Width="96" Height="32"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,14"
                CornerRadius="18"
                Background="#F0141218"
                BorderBrush="#3A3648"
                BorderThickness="1"
                Cursor="Hand"
                MouseLeftButtonUp="Bar_Click"
                ContextMenuOpening="Bar_ContextMenuOpening">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu x:Name="BarMenu" Closed="BarMenu_Closed">
                    <MenuItem x:Name="MenuDictate" Header="Start dictating"
                              Click="MenuDictate_Click" FontWeight="SemiBold"/>
                    <Separator/>
                    <MenuItem Header="Open FlowType" Click="MenuOpen_Click"/>
                    <MenuItem Header="Settings" Click="MenuSettings_Click"/>
                    <Separator/>
                    <MenuItem Header="Hide this bar" Click="MenuHideBar_Click"/>
                    <MenuItem Header="Quit FlowType" Click="MenuQuit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- Idle: quiet mini-waveform -->
                <StackPanel x:Name="IdlePanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Recording: dot + live waveform + timer -->
                <StackPanel x:Name="RecordingPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Ellipse x:Name="RecDot" Width="9" Height="9" Fill="#FF5A66"
                             VerticalAlignment="Center"/>
                    <StackPanel x:Name="BarsPanel" Orientation="Horizontal" Height="30"
                                Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimeText" Text="0:00" Foreground="#F2F0F7"
                               FontSize="12.5" VerticalAlignment="Center"
                               Width="34" TextAlignment="Right"/>
                </StackPanel>

                <!-- Processing -->
                <StackPanel x:Name="ProcessingPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="#7C6CFF" Margin="2,0"/>
                    <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="#7C6CFF" Margin="2,0"/>
                    <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="#7C6CFF" Margin="2,0"/>
                    <TextBlock Text="Transcribing" Foreground="#C8C3D4" FontSize="12.5"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Flash / error message -->
                <TextBlock x:Name="MessageText" Foreground="#F2F0F7" FontSize="12.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" MaxWidth="420" TextTrimming="CharacterEllipsis"
                           Margin="16,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
