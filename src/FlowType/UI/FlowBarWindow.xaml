<Window x:Class="FlowType.UI.FlowBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowType Bar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="460" Height="56">
    <Grid>
        <!-- Sized to stay out of the way: the pill hugs the taskbar (4 px
             gap) and never grows past a single text line in height, so it
             no longer sits on top of chat boxes at the bottom of a window. -->
        <Border x:Name="Bar"
                Width="72" Height="22"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,4"
                CornerRadius="14"
                Background="#F20E0E0E"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                Cursor="Hand"
                MouseLeftButtonUp="Bar_Click"
                ContextMenuOpening="Bar_ContextMenuOpening">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.45"/>
            </Border.Effect>
            <Border.ContextMenu>
                <ContextMenu x:Name="BarMenu" Closed="BarMenu_Closed">
                    <MenuItem x:Name="MenuDictate" Header="Start dictating"
                              Click="MenuDictate_Click" FontWeight="SemiBold"/>
                    <Separator/>
                    <MenuItem Header="Open FlowType" Click="MenuOpen_Click"/>
                    <MenuItem Header="Settings" Click="MenuSettings_Click"/>
                    <Separator/>
                    <MenuItem Header="Hide this bar" Click="MenuHideBar_Click"/>
                    <MenuItem Header="Quit FlowType" Click="MenuQuit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- Idle: quiet mini-waveform -->
                <StackPanel x:Name="IdlePanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Recording: dot + live waveform + timer -->
                <StackPanel x:Name="RecordingPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Ellipse x:Name="RecDot" Width="7" Height="7" Fill="#FF5252"
                             VerticalAlignment="Center"/>
                    <StackPanel x:Name="BarsPanel" Orientation="Horizontal" Height="18"
                                Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimeText" Text="0:00" Foreground="#F4F4F4"
                               FontSize="11" VerticalAlignment="Center"
                               Width="30" TextAlignment="Right"/>
                </StackPanel>

                <!-- Processing -->
                <StackPanel x:Name="ProcessingPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <Ellipse x:Name="Dot1" Width="5" Height="5" Fill="#FFFFFF" Margin="1.5,0"/>
                    <Ellipse x:Name="Dot2" Width="5" Height="5" Fill="#FFFFFF" Margin="1.5,0"/>
                    <Ellipse x:Name="Dot3" Width="5" Height="5" Fill="#FFFFFF" Margin="1.5,0"/>
                    <TextBlock Text="Transcribing" Foreground="#BDBDBD" FontSize="11"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Flash / error message -->
                <TextBlock x:Name="MessageText" Foreground="#F4F4F4" FontSize="11.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" MaxWidth="400" TextTrimming="CharacterEllipsis"
                           Margin="14,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
