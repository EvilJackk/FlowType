<Window x:Class="FlowType.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowType"
        Width="1180" Height="780"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource BodyFont}"
        FontSize="15"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======= Sidebar ======= -->
        <Border x:Name="Sidebar" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,26,18,28">
                    <Image Source="/Resources/logo.png" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="FlowType" FontSize="20" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}"
                               Foreground="{StaticResource TextBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Engine status: what is loaded, where it runs, and whether dictation is paused.
                     Clicking it opens Settings at the speech model. -->
                <Button DockPanel.Dock="Bottom" x:Name="EngineFooter" Style="{StaticResource BareButton}"
                        Margin="12,0,12,16" Click="EngineFooter_Click"
                        ToolTip="Open speech model settings"
                        AutomationProperties.Name="Engine status — open speech model settings">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <Border x:Name="PausedBadge" Visibility="Collapsed" Margin="0,0,0,10"
                                    Background="{StaticResource DangerSoftBrush}" CornerRadius="6"
                                    Padding="8,3,8,4" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource DangerBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Dictation paused" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource DangerBrush}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="SpeechDot" Width="7" Height="7" Margin="0,6,0,0"
                                         VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{StaticResource FaintBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="SpeechModelText" FontSize="13" FontWeight="Medium"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SpeechRuntimeText" FontSize="12"
                                               Foreground="{StaticResource FaintBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="AiDot" Width="7" Height="7" Margin="0,6,0,0"
                                         VerticalAlignment="Top" HorizontalAlignment="Left"
                                         Fill="{StaticResource FaintBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="AiModelText" FontSize="13" FontWeight="Medium"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="AiRuntimeText" FontSize="12"
                                               Foreground="{StaticResource FaintBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,12,0,10"/>
                            <TextBlock x:Name="HotkeyFooterText" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Button>

                <RadioButton DockPanel.Dock="Bottom" x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                             Tag="{StaticResource IconSettings}" Margin="0,0,0,12"
                             Content="Settings" Checked="Nav_Checked"/>

                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="{StaticResource IconHome}"
                                 Content="Home" IsChecked="True" Checked="Nav_Checked"/>
                    <!-- The dot: suggestions from "Learn from your writing" are waiting for review. -->
                    <RadioButton x:Name="NavInsights" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="{StaticResource IconInsights}"
                                 AutomationProperties.Name="Insights" Checked="Nav_Checked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Insights" VerticalAlignment="Center"/>
                            <Ellipse x:Name="InsightsDot" Width="7" Height="7" Margin="9,1,0,0"
                                     Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="PERSONALIZE" Style="{StaticResource Eyebrow}" FontSize="11"
                               Margin="24,22,0,8"/>
                    <RadioButton x:Name="NavDictionary" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="{StaticResource IconDictionary}"
                                 Content="Dictionary" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSnippets" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="{StaticResource IconSnippets}"
                                 Content="Snippets" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavStyle" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="{StaticResource IconStyle}"
                                 Content="Style" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAi" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Tag="{StaticResource IconAi}"
                                 Content="AI" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======= Content: the visible page ======= -->
        <ContentControl Grid.Column="1" x:Name="PageHost" Focusable="False"
                        IsTabStop="False"/>
    </Grid>
</Window>
